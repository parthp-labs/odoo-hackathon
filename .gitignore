# Dependencies
node_modules/
*/node_modules/
frontend/node_modules/
backend/node_modules/

# Environment variables & secrets
.env
.env.local
.env.*.local
*.env

# Editor/backup copies of secret files (e.g. .env~, .env.bak) — never commit
.env~*
.env*~
.env.*.bak
.env.*.orig
.env.*.swp
*.env~

# Template files are safe to commit and MUST stay trackable
!.env.example
!.env.*.example

# Logs & debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Production build outputs
dist/
build/
frontend/dist/
out/
.next/

# Editor & OS files
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Temporary & test coverage
.coverage/
coverage/
.turbo/
.cache/
